msgid "The expression is too long (max 2000 characters)."
msgstr "عبارت بیش از حد طولانی است (حداکثر ۲۰۰۰ کاراکتر)."

msgid "The expression uses a variable that is not defined."
msgstr "عبارت از متغیری استفاده می‌کند که تعریف نشده است."

msgid "The formula divides by zero."
msgstr "فرمول بر صفر تقسیم می‌کند."

msgid "The formula expression is invalid, so the price was left unchanged."
msgstr "عبارت فرمول نامعتبر است، بنابراین قیمت بدون تغییر ماند."

msgid "The formula is not valid."
msgstr "فرمول معتبر نیست."

msgid "The formula is valid."
msgstr "فرمول معتبر است."

msgid "The formula produced a price that is not a positive number."
msgstr "فرمول قیمتی تولید کرد که عددی مثبت نیست."

msgid "The formula takes the square root of a negative number."
msgstr "فرمول از یک عدد منفی جذر می‌گیرد."

msgid "The formula uses a variable that has no value."
msgstr "فرمول از متغیری استفاده می‌کند که مقدار ندارد."

msgid "The formula was evaluated."
msgstr "فرمول محاسبه شد."

msgid "The function is called with the wrong number of arguments."
msgstr "تابع با تعداد آرگومان نادرست فراخوانی شده است."

msgid "The price could not be calculated with the formula “%s”."
msgstr "قیمت با فرمول «%s» محاسبه نشد."

msgid "The product is missing a value the formula needs (for example its weight)."
msgstr "محصول فاقد مقداری است که فرمول لازم دارد (برای مثال وزن آن)."

msgid "The result is not a finite number."
msgstr "نتیجه عدد محدود نیست."

msgid "The sample formulas already exist."
msgstr "فرمول‌های نمونه از قبل وجود دارند."

msgid "The square root of a negative number is not defined."
msgstr "جذر یک عدد منفی تعریف نشده است."

msgid "There is no enabled formula yet."
msgstr "هنوز هیچ فرمول فعالی وجود ندارد."

msgid "This currency has no rate yet, so the price cannot be calculated."
msgstr "این ارز هنوز نرخ ندارد، بنابراین قیمت محاسبه نمی‌شود."

msgid "This function is not supported."
msgstr "این تابع پشتیبانی نمی‌شود."

msgid "This name is reserved and cannot be used as a variable."
msgstr "این نام رزرو شده و نمی‌تواند به‌عنوان متغیر استفاده شود."

msgid "This product has no value for this field, so the price cannot be calculated."
msgstr "این محصول برای این فیلد مقداری ندارد، بنابراین قیمت محاسبه نمی‌شود."

msgid "Type"
msgstr "نوع"

msgid "US dollar"
msgstr "دلار آمریکا"

msgid "Unexpected syntax. Check the operators and parentheses."
msgstr "ساختار نادرست است. عملگرها و پرانتزها را بررسی کنید."

msgid "Unused variables: %s"
msgstr "متغیرهای بی‌استفاده: %s"

msgid "Use the global setting"
msgstr "استفاده از تنظیم جهانی"

msgid "Variables"
msgstr "متغیرها"

msgid "Variables:"
msgstr "متغیرها:"

msgid "Weight"
msgstr "وزن"

msgid "Weight (g)"
msgstr "وزن (گرم)"

msgid "Width"
msgstr "عرض"

msgid "default: %s"
msgstr "پیش‌فرض: %s"

msgid "formula"
msgstr "فرمول"

msgid "live rate"
msgstr "نرخ روز"

msgid "min %1$s, max %2$s"
msgstr "حداقل %1$s، حداکثر %2$s"
