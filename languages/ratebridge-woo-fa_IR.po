# ─────────────────────────────────────────────────────────────────────────────
# Rounding and units
# ─────────────────────────────────────────────────────────────────────────────
msgid "Examples: 1000, 10000, 100000. Ignored when the mode is \"None\"."
msgstr "مثال: ۱۰۰۰، ۱۰۰۰۰، ۱۰۰۰۰۰. در حالت «بدون گرد کردن» نادیده گرفته می‌شود."

msgid "None"
msgstr "بدون گرد کردن"

msgid "Preview (1,234,567): %s"
msgstr "پیش‌نمایش (۱٬۲۳۴٬۵۶۷): %s"

msgid "Round down (floor)"
msgstr "گرد کردن به پایین"

msgid "Round to nearest N"
msgstr "گرد کردن به نزدیک‌ترین مضرب N"

msgid "Round up (ceil)"
msgstr "گرد کردن به بالا"

msgid "Store currency unit"
msgstr "واحد پول فروشگاه"

msgid "Used when displaying calculated prices (product pricing arrives in a later version). Stored rates follow this unit."
msgstr "برای نمایش قیمت‌های محاسبه‌شده استفاده می‌شود (قیمت‌گذاری محصول در نسخه بعدی اضافه می‌شود). نرخ‌های ذخیره‌شده نیز بر همین واحد استوارند."

# ─────────────────────────────────────────────────────────────────────────────
# Price sources tab
# ─────────────────────────────────────────────────────────────────────────────
msgid "API key"
msgstr "کلید API"

msgid "API token"
msgstr "توکن API"

msgid "A value is stored. Leave empty to keep it."
msgstr "مقداری ذخیره شده است. برای حفظ آن، خالی بگذارید."

msgid "AlanChand"
msgstr "آلان‌چند"

msgid "Average of buy and sell"
msgstr "میانگین خرید و فروش"

msgid "Buy price"
msgstr "قیمت خرید"

msgid "Configured"
msgstr "تنظیم شده"

msgid "Connection failed"
msgstr "اتصال ناموفق"

msgid "Connection successful"
msgstr "اتصال موفق"

msgid "Copy the token from your AlanChand account panel. It is sent only in the Authorization header."
msgstr "توکن را از پنل کاربری آلان‌چند خود بردارید. این مقدار فقط در سرآیند Authorization ارسال می‌شود."

msgid "Copy the value shown in your Navasan user panel under the API section."
msgstr "مقدار نمایش‌داده‌شده در پنل کاربری نواسان، بخش API، را کپی کنید."

msgid "Default item price"
msgstr "قیمت پیش‌فرض آیتم"

msgid "Each source has its own request quota. The plugin never sends more requests than the limits you configure here; when a limit is reached the previous rate is kept."
msgstr "هر منبع قیمت سهمیه درخواست خودش را دارد. افزونه هرگز بیش از محدودیت‌های تعیین‌شده در اینجا درخواست نمی‌فرستد؛ وقتی سهمیه تمام شود، نرخ قبلی حفظ می‌شود."

msgid "Every 5 minutes (RateBridge)"
msgstr "هر ۵ دقیقه (نرخ ساز)"

msgid "Fill in the required settings and save before testing the connection."
msgstr "پیش از تست اتصال، تنظیمات الزامی را تکمیل و ذخیره کنید."

msgid "Last error: %s"
msgstr "آخرین خطا: %s"

msgid "Last request"
msgstr "آخرین درخواست"

msgid "Maximum hourly variation (0 to 0.5). Default 0.02 = ±2%."
msgstr "بیشترین نوسان ساعتی (۰ تا ۰٫۵). پیش‌فرض ۰٫۰۲ یعنی ±۲٪."

msgid "Minimum interval"
msgstr "کمترین فاصله بین درخواست‌ها"

msgid "Minimum minutes between requests"
msgstr "کمترین فاصله بین درخواست‌ها (دقیقه)"

msgid "Mock / test data (development only)"
msgstr "داده آزمایشی (فقط برای توسعه)"

msgid "Monthly request limit"
msgstr "محدودیت درخواست ماهانه"

msgid "Monthly request usage"
msgstr "میزان مصرف درخواست ماهانه"

msgid "Navasan"
msgstr "نواسان"

msgid "Next allowed request"
msgstr "درخواست مجاز بعدی"

msgid "No source with settings is registered."
msgstr "هیچ منبع قیمتی با تنظیمات ثبت نشده است."

msgid "No value stored yet."
msgstr "هنوز مقداری ذخیره نشده است."

msgid "Not configured"
msgstr "تنظیم نشده"

msgid "Parsed: %d"
msgstr "تعداد نمادهای خوانده‌شده: %d"

msgid "Price source"
msgstr "منبع قیمت"

msgid "Price sources"
msgstr "منابع قیمت"

msgid "Price type"
msgstr "نوع قیمت"

msgid "Request counters reset."
msgstr "شمارنده‌های درخواست بازنشانی شد."

msgid "Request quota"
msgstr "سهمیه درخواست"

msgid "Requests this month"
msgstr "درخواست‌های این ماه"

msgid "Reset counters"
msgstr "بازنشانی شمارنده‌ها"

msgid "Reset this source’s request counters? This does not refund real requests already sent."
msgstr "شمارنده‌های درخواست این منبع بازنشانی شود؟ این کار درخواست‌های واقعی ارسال‌شده را جبران نمی‌کند."

msgid "Sample:"
msgstr "نمونه:"

msgid "Search symbol…"
msgstr "جستجوی نماد…"

msgid "Sell price"
msgstr "قیمت فروش"

msgid "Test connection"
msgstr "تست اتصال"

msgid "The AlanChand API token is not configured. Add it in “Price sources”."
msgstr "توکن API آلان‌چند تنظیم نشده است. آن را در «منابع قیمت» وارد کنید."

msgid "The Navasan API key is not configured. Add it in “Price sources”."
msgstr "کلید API نواسان تنظیم نشده است. آن را در «منابع قیمت» وارد کنید."

msgid "The bearer token issued by AlanChand."
msgstr "توکن Bearer که آلان‌چند صادر کرده است."

msgid "The free plan allows about 120 requests per month. The plugin never exceeds this number."
msgstr "طرح رایگان حدود ۱۲۰ درخواست در ماه اجازه می‌دهد. افزونه هرگز از این عدد فراتر نمی‌رود."

msgid "The key issued by your Navasan account panel."
msgstr "کلیدی که پنل کاربری نواسان برای شما صادر کرده است."

msgid "The monthly request limit for %1$s has been reached (%2$d of %3$d). No request was sent to the provider."
msgstr "محدودیت درخواست ماهانه %1$s به پایان رسیده است (%2$d از %3$d). هیچ درخواستی به منبع ارسال نشد."

msgid "The test plan allows one request per hour. The plugin will never send requests faster than this."
msgstr "طرح آزمایشی اجازه یک درخواست در ساعت می‌دهد. افزونه هرگز سریع‌تر از این درخواست نمی‌فرستد."

msgid "This source does not use a network connection, so there is nothing to test."
msgstr "این منبع از اتصال شبکه استفاده نمی‌کند، بنابراین چیزی برای تست وجود ندارد."

msgid "This source has no preset symbol list. Enter the symbol manually."
msgstr "این منبع فهرست نماد آماده ندارد. نماد را دستی وارد کنید."

msgid "Which value to read when the API offers both a buy and a sell price."
msgstr "در صورتی که API هم قیمت خرید و هم قیمت فروش بدهد، کدام مقدار خوانده شود."

msgid "never"
msgstr "هرگز"

msgid "now"
msgstr "اکنون"

# ─────────────────────────────────────────────────────────────────────────────
# Add / edit currency dialog
# ─────────────────────────────────────────────────────────────────────────────
msgid "Add this currency from the source preset?"
msgstr "این ارز از فهرست آماده منبع اضافه شود؟"

msgid "Cancel"
msgstr "انصراف"

msgid "Code and name are required."
msgstr "کد و نام الزامی است."

msgid "Custom symbol (free text)"
msgstr "نماد دلخواه (متن آزاد)"

msgid "Enable %s"
msgstr "فعال‌سازی %s"

msgid "Invalid preset."
msgstr "پیش‌تنظیم نامعتبر است."

msgid "Keep current rate"
msgstr "نرخ فعلی حفظ شود"

msgid "Manual rate (%s per 1 unit)"
msgstr "نرخ دستی (%s برای هر واحد)"

msgid "Pick a preset symbol or type a custom one. Leave empty to reuse the code."
msgstr "یک نماد آماده انتخاب کنید یا نماد دلخواه بنویسید. برای استفاده از کد، خالی بگذارید."

msgid "Pick a price source, then add one of its preset currencies. New rows start disabled so you can review them first."
msgstr "یک منبع قیمت انتخاب کنید و سپس یکی از ارزهای آماده آن را اضافه کنید. ردیف‌های جدید غیرفعال ساخته می‌شوند تا ابتدا آن‌ها را بررسی کنید."

msgid "This code is already used by another currency."
msgstr "این کد قبلاً برای ارز دیگری استفاده شده است."

msgid "This interval (%1$d minutes) is shorter than the source allows (%2$d minutes). The row will only refresh when the source permits it."
msgstr "این بازه (%1$d دقیقه) کوتاه‌تر از حد مجاز منبع (%2$d دقیقه) است. این ردیف تنها زمانی به‌روزرسانی می‌شود که منبع اجازه دهد."

msgid "This symbol is not offered by the selected source."
msgstr "این نماد توسط منبع انتخاب‌شده ارائه نمی‌شود."

msgid "Unique identifier, letters/numbers only (e.g. USD, GOLD18)."
msgstr "شناسه یکتا، فقط حروف و اعداد (مثلاً USD یا GOLD18)."

msgid "Used for the manual provider. Leave empty when editing to keep the current rate."
msgstr "برای منبع دستی استفاده می‌شود. در حالت ویرایش برای حفظ نرخ فعلی، خالی بگذارید."

# ─────────────────────────────────────────────────────────────────────────────
# Notices, confirmations and log
# ─────────────────────────────────────────────────────────────────────────────
msgid "Clear log"
msgstr "پاک کردن گزارش"

msgid "Clear the update log?"
msgstr "گزارش به‌روزرسانی پاک شود؟"

msgid "Could not delete the currency."
msgstr "حذف ارز ممکن نشد."

msgid "Could not save the change."
msgstr "ذخیره تغییر ممکن نشد."

msgid "Could not save the currency."
msgstr "ذخیره ارز ممکن نشد."

msgid "Currency added from presets. Enable it to start updating."
msgstr "ارز از فهرست آماده اضافه شد. برای شروع به‌روزرسانی آن را فعال کنید."

msgid "Currency deleted."
msgstr "ارز حذف شد."

msgid "Currency disabled."
msgstr "ارز غیرفعال شد."

msgid "Currency enabled."
msgstr "ارز فعال شد."

msgid "Currency not found."
msgstr "ارز یافت نشد."

msgid "Currency saved."
msgstr "ارز ذخیره شد."

msgid "Delete all plugin data (currencies, settings, log) when the plugin is uninstalled"
msgstr "با حذف افزونه، تمام داده‌ها (ارزها، تنظیمات و گزارش) پاک شود"

msgid "Delete this currency? This cannot be undone."
msgstr "این ارز حذف شود؟ این کار قابل بازگشت نیست."

msgid "Keep this off unless you are sure. Deactivating the plugin never deletes data."
msgstr "تا زمانی که مطمئن نیستید این گزینه را خاموش بگذارید. غیرفعال کردن افزونه هرگز داده‌ها را پاک نمی‌کند."

msgid "Log cleared."
msgstr "گزارش پاک شد."

msgid "No currencies were due for an update."
msgstr "هیچ ارزی برای به‌روزرسانی زمان‌بندی‌نشده بود."

msgid "No currencies yet. Use “Add currency” to create one."
msgstr "هنوز ارزی وجود ندارد. با «افزودن ارز» یکی بسازید."

msgid "No update attempts recorded yet."
msgstr "هنوز تلاشی برای به‌روزرسانی ثبت نشده است."

msgid "Nothing to update."
msgstr "چیزی برای به‌روزرسانی نیست."

msgid "Provider settings saved."
msgstr "تنظیمات منبع قیمت ذخیره شد."

msgid "Rates are currently stored in %1$s. The cron hook is %2$s."
msgstr "نرخ‌ها در حال حاضر بر پایه %1$s ذخیره می‌شوند. قلاب زمان‌بندی: %2$s"

msgid "Rates are stored in %1$s per 1 unit. Next automatic run: %2$s"
msgstr "نرخ‌ها بر پایه %1$s برای هر واحد ذخیره می‌شوند. اجرای خودکار بعدی: %2$s"

msgid "Security check failed. Please reload the page."
msgstr "بررسی امنیتی ناموفق بود. لطفاً صفحه را دوباره بارگذاری کنید."

msgid "Settings saved."
msgstr "تنظیمات ذخیره شد."

msgid "Something went wrong. Please try again."
msgstr "مشکلی پیش آمد. لطفاً دوباره تلاش کنید."

msgid "Your session has expired. The page will reload so you can retry."
msgstr "نشست شما منقضی شده است. صفحه دوباره بارگذاری می‌شود تا بتوانید دوباره تلاش کنید."

msgid "The code must be 32 characters or fewer."
msgstr "کد باید حداکثر ۳۲ نویسه باشد."

msgid "The minimum refresh interval is %d minutes (WordPress cron limit). Manual currencies are never updated automatically."
msgstr "کمترین بازه به‌روزرسانی %d دقیقه است (محدودیت زمان‌بندی وردپرس). ارزهای دستی هرگز به‌صورت خودکار به‌روزرسانی نمی‌شوند."

msgid "Unknown action."
msgstr "عملیات ناشناخته."

msgid "Unknown provider."
msgstr "منبع قیمت ناشناخته."

msgid "Unknown provider: %s"
msgstr "منبع قیمت ناشناخته: %s"

msgid "Unknown rate provider: %s"
msgstr "منبع نرخ ناشناخته: %s"

msgid "Updated %1$d, failed %2$d. %3$s"
msgstr "%1$d به‌روزرسانی شد، %2$d ناموفق. %3$s"

msgid "You are not allowed to do this."
msgstr "شما اجازه انجام این کار را ندارید."

msgid "You do not have permission to access this page."
msgstr "شما اجازه دسترسی به این صفحه را ندارید."

msgid "not scheduled"
msgstr "زمان‌بندی نشده"

msgid "Applied to newly added currencies. Minimum %d minutes because WordPress cron cannot run more often."
msgstr "برای ارزهای تازه‌افزوده اعمال می‌شود. حداقل %d دقیقه، زیرا زمان‌بندی وردپرس سریع‌تر اجرا نمی‌شود."

msgid "After a failed request the plugin waits at least %d minutes before trying that source again, so a broken key never burns the quota."
msgstr "پس از یک درخواست ناموفق، افزونه حداقل %d دقیقه صبر می‌کند تا دوباره آن منبع را امتحان کند؛ بنابراین یک کلید خراب هرگز سهمیه را نمی‌سوزاند."

# ─────────────────────────────────────────────────────────────────────────────
# Provider and HTTP errors (must never contain secrets)
# ─────────────────────────────────────────────────────────────────────────────
msgid "AlanChand reported an error: %s"
msgstr "آلان‌چند خطا گزارش کرد: %s"

msgid "AlanChand returned a response that is not valid JSON."
msgstr "پاسخ آلان‌چند JSON معتبر نبود."

msgid "AlanChand returned no usable prices."
msgstr "آلان‌چند هیچ قیمت قابل‌استفاده‌ای برنگرداند."

msgid "AlanChand returned none of the requested symbols (%s)."
msgstr "آلان‌چند هیچ‌یک از نمادهای درخواستی (%s) را برنگرداند."

msgid "HTTP request failed: %s"
msgstr "درخواست HTTP ناموفق بود: %s"

msgid "Manual (typed by admin)"
msgstr "دستی (ورود توسط مدیر)"

msgid "Manual currencies are not updated automatically. Edit the currency to change its rate."
msgstr "ارزهای دستی به‌صورت خودکار به‌روزرسانی نمی‌شوند. برای تغییر نرخ، ارز را ویرایش کنید."

msgid "Navasan reported an error: %s"
msgstr "نواسان خطا گزارش کرد: %s"

msgid "Navasan returned a response that is not valid JSON."
msgstr "پاسخ نواسان JSON معتبر نبود."

msgid "Navasan returned no usable prices."
msgstr "نواسان هیچ قیمت قابل‌استفاده‌ای برنگرداند."

msgid "Navasan returned none of the requested symbols (%s)."
msgstr "نواسان هیچ‌یک از نمادهای درخواستی (%s) را برنگرداند."

msgid "No symbols requested."
msgstr "هیچ نمادی درخواست نشد."

msgid "No symbols were requested."
msgstr "هیچ نمادی درخواست نشد."

msgid "No test symbol is available for this source."
msgstr "هیچ نماد آزمایشی برای این منبع موجود نیست."

msgid "Provider \"%s\" cannot fetch rates automatically."
msgstr "منبع «%s» نمی‌تواند نرخ‌ها را به‌صورت خودکار دریافت کند."

msgid "Provider returned no valid rate for \"%s\"."
msgstr "منبع هیچ نرخ معتبری برای «%s» برنگرداند."

msgid "The manual provider does not parse remote responses."
msgstr "منبع دستی پاسخ‌های راه دور را پردازش نمی‌کند."

msgid "The mock provider does not use HTTP."
msgstr "منبع آزمایشی از HTTP استفاده نمی‌کند."

msgid "The provider returned no usable rates."
msgstr "منبع هیچ نرخ قابل‌استفاده‌ای برنگرداند."

msgid "This provider does not define an endpoint."
msgstr "این منبع هیچ نشانی پایانه‌ای تعریف نکرده است."

msgid "Unexpected HTTP status: %d"
msgstr "وضعیت HTTP پیش‌بینی‌نشده: %d"

msgid "This plugin requires WooCommerce to be installed and active. Its features are disabled until WooCommerce is activated."
msgstr "این افزونه به نصب و فعال بودن ووکامرس نیاز دارد. تا زمان فعال شدن ووکامرس، امکانات آن غیرفعال است."

msgid "RateBridge Woo"
msgstr "نرخ ساز"

msgid "Refresh log"
msgstr "تازه‌سازی گزارش"

msgid "Volatility"
msgstr "نوسان"

msgid "Add"
msgstr "افزودن"

msgid "Auto schedule"
msgstr "زمان‌بندی خودکار"

msgid "Generated from the symbol. Change it if the code is already taken."
msgstr "از روی نماد ساخته می‌شود. اگر این کد قبلاً استفاده شده، آن را تغییر دهید."

msgid "OK"
msgstr "موفق"

msgid "Select or enter a provider symbol."
msgstr "نماد منبع قیمت را انتخاب یا وارد کنید."

msgid "Swedish Krona"
msgstr "کرون سوئد"

msgid "That code is already used. Suggested: %s"
msgstr "این کد قبلاً استفاده شده است. پیشنهاد: %s"

msgid "The server did not recognise this request (HTTP %d). Please refresh the page."
msgstr "درخواست توسط سرور شناسایی نشد (HTTP %d). صفحه را رفرش کنید."
# ─────────────────────────────────────────────────────────────────────────────
# Phase 3 — product pricing
# ─────────────────────────────────────────────────────────────────────────────

msgid "%1$s: repriced %2$d, skipped %3$d, unchanged-by-fluctuation %4$d, failed %5$d."
msgstr "%1$s: قیمت‌گذاری مجدد %2$d، رد‌شده %3$d، بدون تغییر به‌دلیل حاشیه نوسان %4$d، ناموفق %5$d."

msgid "%s: repricing stopped after too many batches."
msgstr "%s: قیمت‌گذاری مجدد پس از تعداد زیادی دسته متوقف شد."

msgid "A percentage is applied to the converted base value (profit) and to value + profit (commission). Fixed amounts are in the store unit."
msgstr "درصد روی ارزش تبدیل‌شده (سود) و روی ارزش به‌همراه سود (کارمزد) اعمال می‌شود. مبالغ ثابت به واحد فروشگاه (تومان/ریال) هستند."

msgid "A pricing setting (profit, commission or extra) is out of range."
msgstr "یکی از تنظیمات قیمت‌گذاری (سود، کارمزد یا مقدار اضافه) خارج از محدوده مجاز است."

msgid "A pricing setting is out of range."
msgstr "یکی از تنظیمات قیمت‌گذاری خارج از محدوده مجاز است."

msgid "Add the product values to the currency values"
msgstr "افزودن مقدار محصول به مقدار ارز"

msgid "After rounding"
msgstr "پس از گرد کردن"

msgid "After the minimum"
msgstr "پس از اعمال حداقل قیمت"

msgid "Amount in the store unit"
msgstr "مبلغ به واحد فروشگاه"

msgid "Applied to every product priced by this currency. Products can override or extend these values."
msgstr "روی همه محصولاتی که با این ارز قیمت‌گذاری می‌شوند اعمال می‌شود. هر محصول می‌تواند این مقادیر را جایگزین یا تکمیل کند."

msgid "Attention: this converts every stored rate, every fixed profit/commission/extra amount, product minimum prices and fluctuation margins, then recalculates all product prices connected to currencies."
msgstr "توجه: با این کار همه نرخ‌های ذخیره‌شده، همه مبالغ ثابت سود/کارمزد/مقدار اضافه، حداقل قیمت محصولات و حاشیه نوسان تبدیل می‌شوند و قیمت همه محصولات متصل به ارزها دوباره محاسبه می‌شود."

msgid "Base price (in the currency)"
msgstr "قیمت پایه (به واحد ارز)"

msgid "Base value (price × rate)"
msgstr "ارزش پایه (قیمت × نرخ)"

msgid "Calculated price"
msgstr "قیمت محاسبه‌شده"

msgid "Calculating…"
msgstr "در حال محاسبه…"

msgid "Change is inside the fluctuation margin, the price was kept."
msgstr "تغییر در محدوده حاشیه نوسان است؛ قیمت قبلی حفظ شد."

msgid "Changing the store unit converts every rate and every fixed amount. Please confirm the change."
msgstr "تغییر واحد فروشگاه، همه نرخ‌ها و همه مبالغ ثابت را تبدیل می‌کند. لطفاً این تغییر را تأیید کنید."

msgid "Changing the store unit multiplies or divides every stored rate and every fixed amount by 10, and all product prices will be recalculated. Continue?"
msgstr "تغییر واحد فروشگاه همه نرخ‌های ذخیره‌شده و همه مبالغ ثابت را در ۱۰ ضرب یا بر ۱۰ تقسیم می‌کند و قیمت همه محصولات دوباره محاسبه می‌شود. ادامه می‌دهید؟"

msgid "Commission"
msgstr "کارمزد"

msgid "Controlled by the currency"
msgstr "کنترل‌شده توسط ارز"

msgid "Converted %1$d currencies and %2$d products. Prices are being recalculated in the background."
msgstr "%1$d ارز و %2$d محصول تبدیل شد. قیمت‌ها در پس‌زمینه دوباره محاسبه می‌شوند."

msgid "Currency (parent currency)"
msgstr "ارز (ارز والد)"

msgid "Enable “Pricing by currency” on the parent product to price this variation by a currency."
msgstr "برای قیمت‌گذاری این تنوع با ارز، گزینه «قیمت‌گذاری با نرخ ارز» را در محصول والد فعال کنید."

msgid "Enter the base price first."
msgstr "ابتدا قیمت پایه را وارد کنید."

msgid "Extra amount"
msgstr "مقدار اضافه"

msgid "Final price"
msgstr "قیمت نهایی"

msgid "Final sale price"
msgstr "قیمت ویژه نهایی"

msgid "Fixed amount"
msgstr "مبلغ ثابت"

msgid "Fluctuation margin (%s)"
msgstr "حاشیه نوسان (%s)"

msgid "For example 100 for USD 100, or 4.75 for 4.75 grams of 18K gold."
msgstr "برای مثال ۱۰۰ برای ۱۰۰ دلار، یا ۴٫۷۵ برای ۴٫۷۵ گرم طلای ۱۸ عیار."

msgid "If a rate is older than this, product prices are left unchanged and a warning is shown. Enter 0 to disable the limit. Manual currencies without a timestamp are never considered stale."
msgstr "اگر نرخی قدیمی‌تر از این مقدار باشد، قیمت محصولات تغییر نمی‌کند و یک هشدار نمایش داده می‌شود. برای غیرفعال کردن محدودیت، ۰ وارد کنید. ارزهای دستی که تاریخ به‌روزرسانی ندارند هرگز کهنه در نظر گرفته نمی‌شوند."

msgid "If the new price differs from the previous one by less than this amount, the old price is kept."
msgstr "اگر اختلاف قیمت جدید با قیمت قبلی کمتر از این مقدار باشد، قیمت قبلی حفظ می‌شود."

msgid "Inside the fluctuation margin: the previous price is kept."
msgstr "در محدوده حاشیه نوسان: قیمت قبلی حفظ می‌شود."

msgid "Last calculation: %s"
msgstr "آخرین محاسبه: %s"

msgid "Maximum rate age (hours)"
msgstr "حداکثر سن نرخ (ساعت)"

msgid "Minimum price (%s)"
msgstr "حداقل قیمت (%s)"

msgid "Notice dismissed."
msgstr "اعلان بسته شد."

msgid "Optional sale price in the parent currency."
msgstr "قیمت ویژه اختیاری به ارز والد."

msgid "Optional, in the same currency. Leave empty for no sale price."
msgstr "اختیاری، به همان ارز. برای نداشتن قیمت ویژه خالی بگذارید."

msgid "Percent"
msgstr "درصد"

msgid "Percentage"
msgstr "درصد"

msgid "Percentages must be between 0 and 1000."
msgstr "درصد باید بین ۰ و ۱۰۰۰ باشد."

msgid "Price of this variation in the parent currency."
msgstr "قیمت این تنوع به ارز والد."

msgid "Price preview"
msgstr "پیش‌نمایش قیمت"

msgid "Prices are kept as they are until a fresh rate arrives. You can change the limit in the settings."
msgstr "قیمت‌ها تا رسیدن نرخ تازه بدون تغییر می‌مانند. می‌توانید این محدودیت را در تنظیمات تغییر دهید."

msgid "Prices of this variation are calculated from the parent currency (%s)."
msgstr "قیمت این تنوع از ارز والد (%s) محاسبه می‌شود."

msgid "Pricing by currency"
msgstr "قیمت‌گذاری با نرخ ارز"

msgid "Pricing settings"
msgstr "تنظیمات قیمت‌گذاری"

msgid "Profit"
msgstr "سود"

msgid "Profit, commission and extra amount must be zero or a positive number."
msgstr "سود، کارمزد و مقدار اضافه باید صفر یا عددی مثبت باشند."

msgid "Profit, commission and extra mode"
msgstr "حالت سود، کارمزد و مقدار اضافه"

msgid "Rate"
msgstr "نرخ"

msgid "RateBridge Woo: stale exchange rates"
msgstr "نرخ ساز: نرخ‌های کهنه"

msgid "Rates and fixed amounts (profit, commission, extra amount, minimum price, fluctuation margin) are stored in this unit. Changing it converts every stored amount and recalculates product prices."
msgstr "نرخ‌ها و مبالغ ثابت (سود، کارمزد، مقدار اضافه، حداقل قیمت، حاشیه نوسان) به این واحد ذخیره می‌شوند. با تغییر آن، همه مبالغ ذخیره‌شده تبدیل و قیمت محصولات دوباره محاسبه می‌شود."

msgid "Replace the currency values with the product values"
msgstr "جایگزینی مقدار ارز با مقدار محصول"

msgid "Sale base price (optional)"
msgstr "قیمت پایه ویژه (اختیاری)"

msgid "Select a currency first."
msgstr "ابتدا یک ارز انتخاب کنید."

msgid "Select a currency…"
msgstr "یک ارز انتخاب کنید…"

msgid "Settings saved. The store unit changed from %1$s to %2$s; %3$d currencies and %4$d products were converted and prices are being recalculated."
msgstr "تنظیمات ذخیره شد. واحد فروشگاه از %1$s به %2$s تغییر کرد؛ %3$d ارز و %4$d محصول تبدیل شد و قیمت‌ها دوباره محاسبه می‌شوند."

msgid "Store unit changed from %1$s to %2$s. Converted %3$d currencies and %4$d products; rounding step is now %5$s."
msgstr "واحد فروشگاه از %1$s به %2$s تغییر کرد. %3$d ارز و %4$d محصول تبدیل شد؛ گام گرد کردن اکنون %5$s است."

msgid "The base price is empty, so the price was left unchanged."
msgstr "قیمت پایه خالی است، بنابراین قیمت بدون تغییر ماند."

msgid "The base price is not valid."
msgstr "قیمت پایه معتبر نیست."

msgid "The calculated price is never written below this amount. Leave empty for none."
msgstr "قیمت محاسبه‌شده هرگز کمتر از این مقدار نوشته نمی‌شود. برای نداشتن حداقل، خالی بگذارید."

msgid "The calculation produced a non-finite number."
msgstr "محاسبه عددی نامعتبر تولید کرد."

msgid "The calculation produced a price of zero or less."
msgstr "محاسبه قیمتی برابر صفر یا کمتر تولید کرد."

msgid "The commission was converted from a percentage to an amount because the types differ."
msgstr "کارمزد به‌دلیل تفاوت نوع، از درصد به مبلغ تبدیل شد."

msgid "The currency has no rate yet."
msgstr "این ارز هنوز نرخی ندارد."

msgid "The currency is disabled."
msgstr "این ارز غیرفعال است."

msgid "The currency of this product no longer exists."
msgstr "ارز این محصول دیگر وجود ندارد."

msgid "The currency rate is not valid."
msgstr "نرخ ارز معتبر نیست."

msgid "The exchange rate is older than the configured maximum age."
msgstr "نرخ ارز قدیمی‌تر از حداکثر سن تعیین‌شده است."

msgid "The minimum price was applied."
msgstr "حداقل قیمت اعمال شد."

msgid "The price could not be calculated."
msgstr "قیمت محاسبه نشد."

msgid "The price could not be calculated. Check the currency rate and the base price."
msgstr "قیمت محاسبه نشد. نرخ ارز و قیمت پایه را بررسی کنید."

msgid "The price is already up to date."
msgstr "قیمت از قبل به‌روز است."

msgid "The price was recalculated."
msgstr "قیمت دوباره محاسبه شد."

msgid "The price was rounded."
msgstr "قیمت گرد شد."

msgid "The product could not be loaded as a variable product."
msgstr "محصول به‌عنوان محصول متغیر بارگذاری نشد."

msgid "The profit was converted from a percentage to an amount because the types differ."
msgstr "سود به‌دلیل تفاوت نوع، از درصد به مبلغ تبدیل شد."

msgid "The regular price and the sale price are controlled by the currency and are read-only while pricing by currency is enabled."
msgstr "قیمت عادی و قیمت ویژه توسط ارز کنترل می‌شوند و تا زمانی که قیمت‌گذاری با نرخ ارز فعال است قابل ویرایش نیستند."

msgid "The regular price and the sale price of this variation are controlled by the currency and are read-only."
msgstr "قیمت عادی و قیمت ویژه این تنوع توسط ارز کنترل می‌شوند و قابل ویرایش نیستند."

msgid "The sale price is not lower than the regular price, so it will not be stored."
msgstr "قیمت ویژه کمتر از قیمت عادی نیست، بنابراین ذخیره نمی‌شود."

msgid "The store unit did not change, so nothing was converted."
msgstr "واحد فروشگاه تغییر نکرد، بنابراین چیزی تبدیل نشد."

msgid "There is no enabled currency yet. Enable one in WooCommerce → نرخ ساز → Currencies first."
msgstr "هنوز هیچ ارز فعالی وجود ندارد. ابتدا یکی را در ووکامرس ← نرخ ساز ← ارزها فعال کنید."

msgid "These currencies have not been updated for more than %1$d hours, so product prices are not being recalculated: %2$s"
msgstr "این ارزها بیش از %1$d ساعت به‌روزرسانی نشده‌اند، بنابراین قیمت محصولات دوباره محاسبه نمی‌شود: %2$s"

msgid "This currency has no rate yet."
msgstr "این ارز هنوز نرخی ندارد."

msgid "This currency is disabled."
msgstr "این ارز غیرفعال است."

msgid "This product is not priced by a currency."
msgstr "این محصول با ارز قیمت‌گذاری نشده است."

msgid "This variable product has no variations."
msgstr "این محصول متغیر هیچ تنوعی ندارد."

msgid "Total before the minimum"
msgstr "جمع پیش از حداقل قیمت"

msgid "Use the currency values"
msgstr "استفاده از مقدار ارز"

msgid "Use the parent currency"
msgstr "استفاده از ارز والد"

msgid "Variations are repriced through their parent product."
msgstr "تنوع‌ها از طریق محصول والد قیمت‌گذاری می‌شوند."

msgid "Variations: repriced %1$d, skipped %2$d, failed %3$d."
msgstr "تنوع‌ها: قیمت‌گذاری مجدد %1$d، رد‌شده %2$d، ناموفق %3$d."

msgid "When enabled, the price is calculated from the currency rate in this plugin."
msgstr "در صورت فعال بودن، قیمت از نرخ ارز در این افزونه محاسبه می‌شود."

msgid "With “add”, a percentage and a fixed amount are combined after the percentage is converted to an amount."
msgstr "در حالت «افزودن»، درصد و مبلغ ثابت پس از تبدیل درصد به مبلغ با هم جمع می‌شوند."

msgid "no rate yet"
msgstr "بدون نرخ"

msgid "rate: %1$s %2$s"
msgstr "نرخ: %1$s %2$s"

# ─────────────────────────────────────────────────────────────────────────────
# Phase 3.1 — currency selection clarity + variation pricing fixes
# ─────────────────────────────────────────────────────────────────────────────

msgid " and "
msgstr " و "

msgid "%s is missing"
msgstr "%s وجود ندارد"

msgid "Currency disabled"
msgstr "ارز غیرفعال است"

msgid "Currency has no rate"
msgstr "ارز نرخ ندارد"

msgid "Fix it in the currency settings"
msgstr "آن را در تنظیمات ارز اصلاح کنید"

msgid "No base price"
msgstr "قیمت پایه ندارد"

msgid "No currency is ready: every currency is disabled or has no rate yet, so product prices cannot be calculated."
msgstr "هیچ ارزی آماده نیست: همه ارزها غیرفعال‌اند یا هنوز نرخ ندارند، بنابراین قیمت محصولات محاسبه نمی‌شود."

msgid "No currency selected"
msgstr "ارزی انتخاب نشده است"

msgid "Open the currency settings"
msgstr "باز کردن تنظیمات ارز"

msgid "Prices are not being calculated because the currency %1$s cannot be used: %2$s."
msgstr "قیمت‌ها محاسبه نمی‌شوند چون ارز %1$s قابل استفاده نیست: %2$s."

msgid "Recalculate currency prices"
msgstr "محاسبه دوباره قیمت‌های ارزی"

msgid "Recalculation finished: %1$d repriced, %2$d skipped (no usable currency or no base price), %3$d failed."
msgstr "محاسبه دوباره تمام شد: %1$d قیمت‌گذاری شد، %2$d رد شد (ارز قابل استفاده یا قیمت پایه نداشت)، %3$d ناموفق."

msgid "The currency \"%s\" no longer exists. Prices cannot be calculated."
msgstr "ارز «%s» دیگر وجود ندارد. قیمت‌ها محاسبه نمی‌شوند."

msgid "The parent currency is disabled or has no rate, so this variation keeps its current price (or shows as unavailable when it has none)."
msgstr "ارز والد غیرفعال است یا نرخ ندارد، بنابراین این تنوع قیمت فعلی خود را حفظ می‌کند (و اگر قیمتی نداشته باشد ناموجود نمایش داده می‌شود)."

msgid "The price of “%1$s” was not calculated: %2$s"
msgstr "قیمت «%1$s» محاسبه نشد: %2$s"

msgid "There is no currency yet. Create one in WooCommerce → نرخ ساز → Currencies first."
msgstr "هنوز ارزی وجود ندارد. ابتدا یکی را در ووکامرس ← نرخ ساز ← ارزها بسازید."

msgid "disabled"
msgstr "غیرفعال"

msgid "it has no rate yet"
msgstr "نرخ ندارد"

msgid "it is disabled"
msgstr "غیرفعال است"

msgid "no rate"
msgstr "بدون نرخ"

msgid "not set"
msgstr "تعیین نشده"

msgid "Last calculation:"
msgstr "آخرین محاسبه:"

