# ─────────────────────────────────────────────────────────────────────────────
# Placeholders and counters
# ─────────────────────────────────────────────────────────────────────────────
msgid "%1$d minutes configured, %2$d minutes effective"
msgstr "%1$d دقیقه تنظیم شده، %2$d دقیقه مؤثر"

msgid "%1$d of %2$d"
msgstr "%1$d از %2$d"

msgid "%1$s failed recently. To protect the quota, the next request is allowed in %2$d minutes."
msgstr "%1$s به‌تازگی خطا داد. برای حفظ سهمیه، درخواست بعدی %2$d دقیقه دیگر مجاز است."

msgid "%1$s may only be queried every so often. The next request is allowed in %2$d minutes."
msgstr "از %1$s فقط هر چند وقت یک‌بار می‌توان پرس‌وجو کرد. درخواست بعدی %2$d دقیقه دیگر مجاز است."

msgid "%d (no limit set)"
msgstr "%d (بدون محدودیت)"

msgid "%d currency updated."
msgid_plural "%d currencies updated."
msgstr[0] "%d ارز به‌روزرسانی شد."
msgstr[1] "%d ارز به‌روزرسانی شد."

msgid "%d preset symbols available."
msgstr "%d نماد آماده در دسترس است."

msgid "%s is required."
msgstr "%s الزامی است."

msgid "%s: could not persist the new rate."
msgstr "%s: ذخیره نرخ جدید ممکن نشد."

